<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen widgets' colours on Android 12 and later, light: the launcher's dynamic
     palette (values/widget_colors.xml has the fallbacks). -->
<resources>
    <color name="widget_surface">@android:color/system_neutral1_50</color>
    <color name="widget_on_surface">@android:color/system_neutral1_900</color>
    <color name="widget_on_surface_variant">@android:color/system_neutral2_700</color>
    <color name="widget_primary">@android:color/system_accent1_600</color>
    <color name="widget_track">@android:color/system_accent1_100</color>
    <color name="widget_error">#FFB3261E</color>
</resources>
