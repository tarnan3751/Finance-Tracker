<?xml version="1.0" encoding="utf-8"?>
<!-- The budgets home screen widget (widgets/BudgetsWidgetProvider.kt): 4 by 2 cells to start,
     resizable. updatePeriodMillis is 0: the app and its background cycle write the
     snapshot and ask for a redraw (features/widgets/); the widget never wakes the device. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_budgets_description"
    android:initialLayout="@layout/widget_setup"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
