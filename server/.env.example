# Configuration for the development server (docs/reference/server.md, **Configuration**).
# tools/run_server.sh copies this file to server/.env (gitignored; never commit it) and
# fills in the generated secrets. Every key may also come from the environment, which
# overrides the file. An empty value counts as unset. Lines are KEY=VALUE, no quoting.

# Where to listen. HOST stays 127.0.0.1 (the emulator reaches it at 10.0.2.2); use
# 0.0.0.0 only when a physical device on the LAN must reach the server.
PORT=8080
HOST=127.0.0.1

# The SQLite database, relative to server/ (created with its directory).
DATABASE_PATH=data/finance_tracker.db

# The access-token signing key: at least 32 random bytes, base64. Required.
JWT_SECRET=
# A previous signing key still accepted during a rotation (optional, base64).
JWT_SECRET_PREVIOUS=

# The AES-256-GCM key for Plaid access tokens at rest: exactly 32 bytes, base64. Required.
TOKEN_ENCRYPTION_KEY=

# Plaid. PLAID_MODE=fake uses canned data stamped source: demo and needs no keys.
# PLAID_MODE=sandbox calls Plaid's PLAID_ENV (sandbox, development or production) with
# PLAID_CLIENT_ID and PLAID_SECRET, both required then and never logged.
PLAID_MODE=fake
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Where Plaid delivers webhooks: an https tunnel to /v1/webhooks/plaid (optional; the
# server polls without one). Named in Link and Sandbox tokens created after it is set.
PLAID_WEBHOOK_URL=

# The user seeded at startup: both or neither. An existing user is left unchanged.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# Argon2id parameters for new password hashes (OWASP baseline).
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# json (one object per line) or text (for a terminal).
LOG_FORMAT=json
